# Copy to apps/api/.env for local development. Never commit real values.

# --- Data -------------------------------------------------------------------
# local    = deterministic in-memory seed (no Google Cloud needed)
# bigquery = read tables and trace the BOM with BigQuery Graph
DATA_BACKEND=local
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
BIGQUERY_DATASET=rippleops

# --- Gemini -------------------------------------------------------------------
# Either Vertex AI (uses Application Default Credentials / the Cloud Run service
# account) or a Gemini API key. Without either, RippleOps falls back to
# deterministic, clearly labelled summaries.
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Local only; Cloud Run uses its service account instead.
GOOGLE_APPLICATION_CREDENTIALS=

# --- App ----------------------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
# Fixed "today" for the demo dataset, so results never drift with the calendar.
DEMO_AS_OF=2026-10-01
DEMAND_HORIZON_MONTHS=6
DEFAULT_MARGIN_THRESHOLD=0.20
MAX_UPLOAD_BYTES=2097152
# Reserved for storing uploaded notices; uploads are parsed in memory today.
GCS_BUCKET=

# --- Web (apps/web) -----------------------------------------------------------
# Server-side URL of the FastAPI service used by the Next.js /api proxy.
API_BASE_URL=http://localhost:8000
